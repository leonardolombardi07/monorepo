{
  "name": "excel-addin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "i18n": "paraglide-js compile --project ./src/lib/internationalization/project.inlang",
    "typecheck": "pnpm i18n && tsc",
    "preview": "vite preview",
    "certs": "office-addin-dev-certs install",
    "addin:validate": "office-addin-manifest validate manifest.xml",
    "addin:start": "office-addin-debugging start manifest.xml desktop --app excel",
    "addin:stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.142",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@repo/api-client": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "ai": "^7.0.139",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.3",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.45",
    "@types/node": "catalog:",
    "@types/office-js": "^1.0.611",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
