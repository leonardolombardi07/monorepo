{
  "name": "excel-addin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "certs": "office-addin-dev-certs install",
    "addin:validate": "office-addin-manifest validate manifest.xml",
    "addin:start": "office-addin-debugging start manifest.xml desktop --app excel",
    "addin:stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "@repo/api-client": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/office-js": "^1.0.611",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
