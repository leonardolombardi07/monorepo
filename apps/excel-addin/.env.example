# Copy to .env and fill in, then restart `pnpm dev`.
# LOCAL DEVELOPMENT ONLY: Vite bundles every VITE_* variable into the add-in,
# so anyone who can open the task pane can read this key. Move the model calls
# to a backend before sharing the add-in with anyone.
VITE_OPENROUTER_API_KEY=
# OpenRouter model id; it must support tool calling. Defaults to google/gemma-4-31b-it:free
VITE_OPENROUTER_MODEL=
