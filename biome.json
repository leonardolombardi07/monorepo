{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUndeclaredDependencies": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImportCycles": "error",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": [
							"warn",
							"error"
						]
					}
				}
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"functions": [
							"cn",
							"cva"
						]
					}
				}
			},
			"style": {
				"useImportType": "error",
				"useExportType": "error",
				"noNonNullAssertion": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}